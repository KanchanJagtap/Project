#!/bin/bash

PROJECT="/Users/rohit/Kanchan Jagtap/SIH Project"
FRONTEND="$PROJECT/figma-local-test"
DEMO="$PROJECT/city-anpr-demo"
PYTHON="$DEMO/.venv/bin/python"

LOG="$HOME/Library/Logs/city-anpr-prototype.log"

mkdir -p "$(dirname "$LOG")"

echo "========================================" >> "$LOG"
echo "City ANPR Prototype started: $(date)" >> "$LOG"

# ==========================================================
# CHECK DEMO PYTHON
# ==========================================================

if [ ! -x "$PYTHON" ]; then
    echo "ERROR: Demo Python environment not found." >> "$LOG"
    echo "Expected: $PYTHON" >> "$LOG"
    exit 1
fi

# ==========================================================
# START FASTAPI DEMO BACKEND
# ==========================================================

BACKEND_PID="$(lsof -tiTCP:8000 -sTCP:LISTEN 2>/dev/null | head -1)"

if [ -n "$BACKEND_PID" ]; then

    BACKEND_COMMAND="$(ps -p "$BACKEND_PID" -o command= 2>/dev/null)"

    echo "Port 8000 is already in use by PID $BACKEND_PID" >> "$LOG"
    echo "$BACKEND_COMMAND" >> "$LOG"

    if echo "$BACKEND_COMMAND" | grep -q "$DEMO"; then
        echo "Existing process belongs to City ANPR Demo. Reusing it." >> "$LOG"
    else
        echo "ERROR: Port 8000 is occupied by another application." >> "$LOG"
        echo "$BACKEND_COMMAND" >> "$LOG"
        exit 1
    fi

else

    echo "Starting lightweight DemoANPR backend..." >> "$LOG"

    cd "$DEMO" || {
        echo "ERROR: Demo directory not found." >> "$LOG"
        exit 1
    }

    nohup "$PYTHON" -m uvicorn backend.main:app \
        --host 127.0.0.1 \
        --port 8000 \
        >> "$LOG" 2>&1 &

    BACKEND_PID=$!

    echo "FastAPI PID: $BACKEND_PID" >> "$LOG"
fi

# ==========================================================
# WAIT FOR BACKEND
# ==========================================================

echo "Waiting for DemoANPR backend..." >> "$LOG"

BACKEND_READY=false

for i in {1..30}; do

    STATUS="$(curl -s --max-time 2 \
        http://127.0.0.1:8000/anpr/status 2>/dev/null)"

    if echo "$STATUS" | grep -q '"engine":"DemoANPR"'; then
        BACKEND_READY=true
        echo "DemoANPR backend ready." >> "$LOG"
        break
    fi

    sleep 1
done

if [ "$BACKEND_READY" != true ]; then
    echo "ERROR: DemoANPR backend did not become ready." >> "$LOG"
    echo "Last status response: $STATUS" >> "$LOG"
    exit 1
fi

# ==========================================================
# START VITE FRONTEND
# ==========================================================

FRONTEND_PID="$(lsof -tiTCP:8443 -sTCP:LISTEN 2>/dev/null | head -1)"

if [ -n "$FRONTEND_PID" ]; then

    FRONTEND_COMMAND="$(ps -p "$FRONTEND_PID" -o command= 2>/dev/null)"

    echo "Port 8443 is already in use by PID $FRONTEND_PID" >> "$LOG"
    echo "$FRONTEND_COMMAND" >> "$LOG"

    if echo "$FRONTEND_COMMAND" | grep -q "$FRONTEND"; then
        echo "Existing Vite frontend belongs to City ANPR. Reusing it." >> "$LOG"
    else
        echo "ERROR: Port 8443 is occupied by another application." >> "$LOG"
        echo "$FRONTEND_COMMAND" >> "$LOG"
        exit 1
    fi

else

    echo "Starting Vite frontend..." >> "$LOG"

    cd "$FRONTEND" || {
        echo "ERROR: Frontend directory not found." >> "$LOG"
        exit 1
    }

    nohup npm run dev -- \
        --host 127.0.0.1 \
        --port 8443 \
        >> "$LOG" 2>&1 &

    FRONTEND_PID=$!

    echo "Vite PID: $FRONTEND_PID" >> "$LOG"
fi

# ==========================================================
# WAIT FOR FRONTEND
# ==========================================================

echo "Waiting for frontend..." >> "$LOG"

for i in {1..30}; do

    if curl -s --max-time 2 \
        http://127.0.0.1:8443 >/dev/null 2>&1; then

        echo "Frontend ready." >> "$LOG"

        open -a "Safari" \
            "http://127.0.0.1:8443"

        echo "City ANPR Prototype launched successfully." >> "$LOG"

        exit 0
    fi

    sleep 1
done

echo "ERROR: Frontend failed to start." >> "$LOG"

exit 1
