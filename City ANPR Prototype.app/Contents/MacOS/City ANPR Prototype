#!/bin/bash

PROJECT="/Users/rohit/Kanchan Jagtap/SIH Project"
FRONTEND="$PROJECT/figma-local-test"
DEMO="$PROJECT/city-anpr-demo"
LOG="$HOME/Library/Logs/city-anpr-prototype.log"

mkdir -p "$(dirname "$LOG")"

echo "===== City ANPR Prototype $(date) =====" >> "$LOG"

# -------------------------------
# START FASTAPI BACKEND
# -------------------------------

if ! lsof -nP -iTCP:8000 -sTCP:LISTEN >/dev/null 2>&1; then

    cd "$DEMO" || {
        echo "ERROR: Demo directory not found." >> "$LOG"
        exit 1
    }

    PYTHON="$DEMO/.venv/bin/python"

    if [ ! -x "$PYTHON" ]; then
        PYTHON="$(command -v python3)"
    fi

    echo "Starting FastAPI..." >> "$LOG"

    nohup "$PYTHON" -m uvicorn backend.main:app \
        --host 127.0.0.1 \
        --port 8000 \
        >> "$LOG" 2>&1 &

else
    echo "FastAPI already running." >> "$LOG"
fi


# -------------------------------
# START VITE FRONTEND
# -------------------------------

if ! lsof -nP -iTCP:8443 -sTCP:LISTEN >/dev/null 2>&1; then

    cd "$FRONTEND" || {
        echo "ERROR: Frontend directory not found." >> "$LOG"
        exit 1
    }

    echo "Starting Vite..." >> "$LOG"

    nohup npm run dev -- \
        --host 127.0.0.1 \
        --port 8443 \
        >> "$LOG" 2>&1 &

else
    echo "Vite already running." >> "$LOG"
fi


# -------------------------------
# WAIT FOR FRONTEND
# -------------------------------

echo "Waiting for frontend..." >> "$LOG"

for i in {1..30}; do

    if curl -s http://127.0.0.1:8443 >/dev/null 2>&1; then
        echo "Frontend ready." >> "$LOG"
        open -a "Safari" "http://127.0.0.1:8443"
        exit 0
    fi

    sleep 1
done


echo "ERROR: Frontend failed to start." >> "$LOG"

exit 1
