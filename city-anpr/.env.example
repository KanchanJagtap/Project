# ==============================================================================
# City-Wide AI Engine — Environment Configuration Example (.env.example)
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit real secrets or .env to version control.
# ==============================================================================

# PostgreSQL Configuration (Docker & Local)
POSTGRES_USER=city_anpr_user
POSTGRES_PASSWORD=city_anpr_secure_password
POSTGRES_DB=city_anpr
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async SQLAlchemy Connection String (used by FastAPI app and Alembic)
DATABASE_URL=postgresql+asyncpg://city_anpr_user:city_anpr_secure_password@localhost:5432/city_anpr

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
